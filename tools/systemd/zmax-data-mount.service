# 2026-09-30 由 tools/zmax_bootstrap.py 的 systemd 步骤装回本机;
# 本文件从 /etc/systemd/system/zmax-data-mount.service 收回仓库。
# 密钥类值已替换为 ${ZMAX_AGENT_TOKEN}/${ZMAX_ECS_PW}, 真值放 /home/ubuntu/zmax_data/secrets/zmax.env (600)。
[Unit]
Description=Z-MAX E盘公共数据盘自动挂载 (U盘启动时 bind 数据目录)
After=local-fs.target
ConditionPathExists=/dev/nvme0n1p5

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zmax-data-mount.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
