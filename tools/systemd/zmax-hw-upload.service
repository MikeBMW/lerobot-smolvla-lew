[Unit]
Description=Z-MAX 4060 硬件(含显存)上报 ECS relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zmax
ExecStart=/usr/bin/python3 /home/ubuntu/zmax/tools/hw_uploader.py --watch 3
Restart=always
RestartSec=5
StandardOutput=append:/var/log/zmax-hw-upload.log
StandardError=append:/var/log/zmax-hw-upload.log

[Install]
WantedBy=multi-user.target
