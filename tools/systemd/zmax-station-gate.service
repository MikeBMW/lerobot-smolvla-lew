# 2026-09-30 由 tools/zmax_bootstrap.py 的 systemd 步骤装回本机;
# 本文件从 /etc/systemd/system/zmax-station-gate.service 收回仓库。
# 密钥类值已替换为 ${ZMAX_AGENT_TOKEN}/${ZMAX_ECS_PW}/${ZMAX_TUNNEL_TOKEN}, 真值放 /home/ubuntu/zmax_data/secrets/zmax.env (600)。
[Unit]
Description=Z-MAX 工位总览只读闸门 (8793 -> 8893; 放行 /station 与 6 路只读画面, 控制类全挡)
After=network-online.target zmax-tunnel-proxy.service
Wants=network-online.target

[Service]
EnvironmentFile=-/home/ubuntu/zmax_data/secrets/zmax.env
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zmax
ExecStart=/home/ubuntu/zmax/gui-venv311/bin/python /home/ubuntu/zmax/tools/tunnel_proxy.py --port 8893 --upstream 127.0.0.1:8793 --token ${ZMAX_TUNNEL_TOKEN} --mode station
Restart=always
RestartSec=3
StandardOutput=append:/var/log/zmax-station-gate.log
StandardError=append:/var/log/zmax-station-gate.log

[Install]
WantedBy=multi-user.target
